\begin{frame}
	\frametitle{Total Effect Decomposition}
			    
	Total, Direct, and Indirect Effects:
			
	\begin{equation}
		\mathsf{Total}
		=
		\exp{
			\left(
			\Delta t
			\boldsymbol{\Phi}
			\right)
			=
			\boldsymbol{\beta}_{\Delta t}
		}
	\end{equation}
	\begin{equation}
		\mathsf{Direct}
		=
		\exp
		\left(
		\Delta t
		\mathbf{D}_{\mathbf{m}}
		\boldsymbol{\Phi}
		\mathbf{D}_{\mathbf{m}}
		\right)
	\end{equation}
	\begin{equation}
		\mathsf{Indirect}
		=
		\mathsf{Total} - \mathsf{Direct} .
	\end{equation}
			
	Standardized Effects: Effect Size Measures
			
	\begin{equation}
		\mathsf{Total}^{\ast}_{i, j}
		=
		\mathsf{Total}_{i, j} \left( \frac{\sigma_{{x}_{j}}}{\sigma_{{y}_{i}}} \right) ,
	\end{equation}
	\begin{equation}
		\mathsf{Direct}^{\ast}_{i, j}
		=
		\mathsf{Direct}_{i, j} \left( \frac{\sigma_{{x}_{j}}}{\sigma_{{y}_{i}}} \right) , \qquad \mathsf{and}
	\end{equation}
	\begin{equation}
		\mathsf{Indirect}^{\ast}_{i, j} = \mathsf{Total}^{\ast}_{i, j} - \mathsf{Direct}^{\ast}_{i, j}
	\end{equation}
\end{frame}

\begin{frame}
	\frametitle{CT-VAR \parencite{Deboeck-Preacher-2015, Chow-Losardo-Park-etal-2023}}
	Measurement component:
	\begin{equation}
		\begin{gathered}
			\mathbf{y}_{i, t_{m}}
			=
			\boldsymbol{\nu} + \boldsymbol{\Lambda} \boldsymbol{\eta}_{i, t_{m}} + \boldsymbol{\varepsilon}_{i, t_{m}},
			\indent \boldsymbol{\varepsilon}_{i, t_{m}} \sim \mathcal{N} \left( \mathbf{0}, \boldsymbol{\Theta} \right)
		\end{gathered}
	\end{equation}
	Dynamic component:
	\begin{equation}
		\mathsf{d} \boldsymbol{\eta}_{i, t}
		=
		\left( \textcolor{indirect}{\boldsymbol{\Phi}} \boldsymbol{\eta}_{i, t} \right) \mathsf{d}t + \boldsymbol{\Sigma}^{\frac{1}{2}} \mathsf{d} \mathbf{W}_{i, t}
	\end{equation}
	Three-variable CT-VAR mediation model:
	\begin{equation}
		\mathbf{y}
		=
		\left(
		\begin{array}{c}
			X \\ M \\ Y \\
		\end{array}
		\right) ,
		\quad \mathsf{and} \quad
		\boldsymbol{\eta}
		=
		\left(
		\begin{array}{c}
			\eta_X \\ \eta_M \\ \eta_Y \\
		\end{array}
		\right)
	\end{equation}
	Integral form:
	\begin{equation}
		\boldsymbol{\eta}_{i, t_{{m_{i}}}}
		=
		\boldsymbol{\alpha}_{\Delta t_{{m_{i}}}} + \textcolor{indirect}{\boldsymbol{\beta}_{\Delta t_{{m_{i}}}}} \boldsymbol{\eta}_{i, t_{m_{i} - 1}} + \boldsymbol{\zeta}_{i, t_{{m_{i}}}},
		\indent
		\boldsymbol{\zeta}_{i, t_{{m_{i}}}} \sim \mathcal{N} \left( \mathbf{0}, \boldsymbol{\Psi}_{\Delta t_{{m_{i}}}} \right)
	\end{equation}
	\begin{equation}
		\textcolor{indirect}{\boldsymbol{\beta}_{\Delta t_{{m_{i}}}} = \exp \left( \Delta t \boldsymbol{\Phi} \right)}
	\end{equation}
\end{frame}

\begin{frame}
	\frametitle{Delta Method Confidence Intervals}
	We define the delta method following the multivariate central limit theorem. Let $\boldsymbol{\theta}$ be $\mathsf{vec} \left( \boldsymbol{\Phi} \right)$, that is, the elements of the drift matrix $\boldsymbol{\Phi}$ in vector form sorted column-wise. Let $\hat{\boldsymbol{\theta}}$ be $\mathsf{vec} \left( \hat{\boldsymbol{\Phi}} \right)$, that is, the estimates of the elements of the drift matrix. The uncertainty around any functions of the estimates for $\hat{\boldsymbol{\theta}}$ is assumed to be characterized as:
	\begin{equation}
		\sqrt{n}
		\left(
		\mathbf{g} \left( \hat{\boldsymbol{\theta}} \right)
		-
		\mathbf{g} \left( \boldsymbol{\theta} \right)
		\right)
		\xrightarrow[]{
			\mathsf{D}
		}
		\mathcal{N}
		\left(
		0,
		\mathbf{J}
		\boldsymbol{\Gamma}
		\mathbf{J}^{\prime}
		\right)
	\end{equation}
	where $\mathbf{g}$ is a vector of functions, $\mathbf{J}$ is the matrix of first-order derivatives of the functions in $\mathbf{g}$ with respect to the elements of $\boldsymbol{\theta}$ and $\boldsymbol{\Gamma}$ is the asymptotic variance-covariance matrix of $\hat{\boldsymbol{\theta}}$.
	The approximate distribution of $\mathbf{g} \left( \hat{\boldsymbol{\theta}} \right)$ is given by
	\begin{equation}
		\mathbf{g} \left( \hat{\boldsymbol{\theta}} \right)
		\approx
		\mathcal{N}
		\left(
		\mathbf{g} \left( \boldsymbol{\theta} \right)
		,
		n^{-1}
		\mathbf{J}
		\boldsymbol{\Gamma}
		\mathbf{J}^{\prime}
		\right) .
	\end{equation}
	When $\boldsymbol{\Gamma}$ is unknown, by substitution, we can use the estimated sampling variance-covariance matrix of $\hat{\boldsymbol{\theta}}$, that is, $\hat{\mathbb{V}} \left( \hat{\boldsymbol{\theta}} \right)$ for $n^{-1} \boldsymbol{\Gamma}$.
\end{frame}

\begin{frame}
	\frametitle{Monte Carlo (MC) Method Confidence Intervals}
	Based on the asymptotic properties of maximum likelihood estimators, we can assume that they are normally distributed around the population parameters
	\begin{equation}
		\hat{\boldsymbol{\theta}}
		\sim
		\mathcal{N}
		\left(
		\boldsymbol{\theta},
		\mathbb{V} \left( \hat{\boldsymbol{\theta}} \right)
		\right) .
	\end{equation}
	Using this distributional assumption, a sampling distribution of $\hat{\boldsymbol{\theta}}$ which we refer to as $\hat{\boldsymbol{\theta}}^{\ast}$ can be generated by replacing the population parameters with sample estimates, that is,
	\begin{equation}
		\hat{\boldsymbol{\theta}}^{\ast}
		\sim
		\mathcal{N}
		\left(
		\hat{\boldsymbol{\theta}},
		\hat{\mathbb{V}} \left( \hat{\boldsymbol{\theta}} \right)
		\right) .
	\end{equation}
	A sampling distribution of $\mathbf{g} \left( \hat{\boldsymbol{\theta}} \right)$, which we refer to as $\mathbf{g} \left( \hat{\boldsymbol{\theta}}^{\ast} \right)$, can be generated by using the simulated estimates to calculate $\mathbf{g}$. The standard deviations of the simulated estimates are the SEs. In resampling approaches, it is customary to use the percentiles of the generated distribution as CIs instead of the SEs.
\end{frame}

