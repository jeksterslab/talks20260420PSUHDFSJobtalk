\title{Addressing Mechanisms and Heterogeneity in Change with Usable Tools\vspace{-1em}}
\author{Ivan Jacob Agaloos Pesigan (Jek)\\\href{mailto:ijapesigan@psu.edu}{ijapesigan@psu.edu}\vspace{-.9em}}
\institute{{\tiny Postdoctoral Fellow\\Prevention and Methodology Training Program (PAMT)\\Edna Bennett Pierce Prevention Research Center\\The Pennsylvania State University}\vspace{-.9em}}
