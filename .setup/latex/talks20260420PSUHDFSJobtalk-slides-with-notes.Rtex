\begin{frame}
	\frametitle{Total Effect Decomposition}
	\centering
	\small
	\textcolor{direct}{Blue = direct effect ($\beta_{11} \beta_{11} \beta_{31}$).} \textcolor{indirect}{Red = indirect effect ($\beta_{11} \beta_{21} \beta_{32}$).}
