	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item That is the question behind Study 2: can inertia help distinguish qualitatively different drinking patterns, beyond differences in average intoxication level?
			\item Put differently, people may differ not only in how much they drink, but in how strongly intoxication carries forward across days.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{Why this substantive problem demanded a new model}
	% \scriptsize
	% \begin{minipage}[t]{0.48\textwidth}
	% \textbf{Substantive grounding}
	% \begin{itemize}
	% 	\item Addiction and alcohol have been a consistent substantive thread in my work.
	% \end{itemize}
							
	% \textbf{Why this matters}
	% \begin{itemize}
	% 	\item Young adulthood is a high-risk period for heavy episodic drinking.
	% 	\item Risk is not only about \textbf{how much} people drink, but also about \textbf{how intoxication carries over} across days.
	% \end{itemize}
	% \end{minipage}\hfill
	% \begin{minipage}[t]{0.48\textwidth}
	\textbf{Why Study 2 is exciting}
	% Herring-Zamboanga-Olthuis-etal-2016
	% Russell-Richards-Turrisi-etal-2025
	\begin{itemize}
		\item \textbf{Substantive grounding:} Alcohol and addiction have been a consistent part of my applied work {\tiny \parencite[e.g.][]{Zhang-Ku-Wu-et-al-2020, Zhang-Pesigan-Kahler-etal-2019, Zamboanga-Iwamoto-Pesigan-etal-2015, Zamboanga-Pesigan-Tomaso-etal-2015, Yu-Pesigan-Zhang-etal-2019, Yu-Wu-Pesigan-2015}}.
		\item \textbf{Substantive question:} How do risky drinking patterns persist or change across days?
		\item \textbf{Methodological challenge:} Transdermal alcohol concentration (TAC) features are multidimensional, partly shared, partly feature-specific, and dynamic over time.
	\end{itemize}
	% \vspace{0em}
	% \textbf{Data}
	% \begin{itemize}
	% 	\item 222 young adults engaged in weekly HED
	% 	\item 6-day sensor-based monitoring
	% 	\item Baseline alcohol use disorder risk measured using \texttt{AUDIT}
	% \end{itemize}
	% \end{minipage}
	\vspace{0em}
	\normalsize
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{\textbf{Substantive grounding} in addiction research, together with the quantitative expertise to build \textbf{new models} when the science demands them.}
			};
		\end{tikzpicture}
	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item This study is a natural next step for me.
			\item Addiction and alcohol have been a consistent substantive thread in my work, but Study 2 is where that background meets the kind of quantitative contribution I want to make in HDFS.
			\item TAC sensors give us richer and more objective data, but they also create a harder modeling problem: the features are partly shared, partly feature-specific, and changing across days.
			\item That is exactly the setting that motivated CULTA.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{From TAC curves to dynamic questions}
	\begin{minipage}[t]{0.54\textwidth}
		\vspace{0pt}
		\centering
		\includegraphics[width=\linewidth]{.setup/latex/figures/pdf/tac.pdf}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.42\textwidth}
		\vspace{0pt}
		\small
		Simple summaries of the TAC features miss three things:
		\begin{itemize}
			\item what is \textbf{shared} across features,
			\item what is \textbf{feature-specific},
			\item and whether intoxication shows \textbf{inertia} across days.
		\end{itemize}
	\end{minipage}
	\vspace{0em}
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{The question is not just \textbf{how intoxicated was this day?} but also \textbf{what kind of drinking pattern does it reflect, and how stable is that pattern over time?}}
			};
		\end{tikzpicture}
	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item Here, the key data are \textbf{repeated day-specific TAC curves}: across the monitoring period, each participant can contribute multiple drinking-day curves, and from each curve we extract features like peak, rise rate, fall rate, and duration.
			\item But once we do that, a new question appears: are we looking at one common intoxication process, feature-specific expressions of intoxication, or both?
			\item And beyond that, does intoxication carry over across days?
			\item So the substantive question becomes not just how intoxicated this day was, but what kind of drinking pattern it reflects and how stable that pattern is over time.
			\item That is exactly the problem CULTA was designed to solve.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{Profiles differed in mean intoxication and inertia}
	\begin{minipage}[t]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/profiles-2.pdf}
		\vspace{0.3em}
		{\scriptsize \textbf{Difference in mean levels}}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/rs-high-low.pdf}
		\vspace{0.3em}
		{\scriptsize \textbf{Difference in temporal persistence}}
	\end{minipage}\hfill
	\footnotesize
	\begin{itemize}
		\item Chronic HED: \textcolor{myviolet}{Higher intoxication mean} and \textcolor{myblue}{Lower inertia}
		\item Inertia-driven drinking: \textcolor{myteal}{Lower intoxication mean} and \textcolor{myred}{Higher inertia}
	\end{itemize}
	\vspace{0em}
	\normalsize
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=\linewidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{The key point is that these profiles are \textbf{not defined by means alone}. They also differ in \textbf{how strongly intoxication carries forward} across days.}
			};
		\end{tikzpicture}
	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item CULTA answers that question by separating overall intoxication level from temporal persistence.
			\item Two profiles emerged, and the key point is how they differ.
			\item \textbf{Chronic HED} shows higher mean intoxication and lower inertia, which is more consistent with an entrenched heavy-drinking pattern.
			\item \textbf{Inertia-driven drinking} shows lower mean intoxication but stronger carryover across days, suggesting a pattern where recent history---and likely context---still matters for what happens next.
			\item So this is not just a classification result. It shows that risky drinking patterns differ in both level and persistence.
		\end{itemize}
	}
\end{frame}

\begin{frame}{AUD risk predicts getting stuck in chronic HED}
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Start in chronic HED}
		
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.03 $\rightarrow$ 0.07 $\rightarrow$ 0.15}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Stay in chronic HED}
		
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.21 $\rightarrow$ 0.30 $\rightarrow$ 0.40}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Shift into chronic HED}
		
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.03 $\rightarrow$ 0.06 $\rightarrow$ 0.10}
	\end{minipage}
	
	\vspace{0.8em}
	
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{CULTA does not just classify drinking days; it helps identify \textbf{who is likely to get stuck in riskier dynamic patterns}.}
			};
		\end{tikzpicture}
	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item AUD risk helps identify who is more likely to start in, remain in, or shift into the chronic HED profile.
			\item The main pattern is simple: as AUD risk increases, so does the probability of getting stuck in the chronic pattern.
			\item So Study 2 shows that risky drinking patterns are not defined by average intoxication alone, but also by persistence and who gets stuck in maladaptive dynamics over time.
			\item And once we start treating these dynamic signatures as meaningful individual differences, the next question is how to synthesize them at the population level without averaging them away.
			\item That is exactly the problem I take up in Study 3.
		\end{itemize}
	}
\end{frame}

%-------------------------------------------------------------------------------
\section{Study 3}
%-------------------------------------------------------------------------------

\begin{frame}
	\frametitle{Study 3}
	\begin{figure}[ht]
		\centering
		% Main figure
		\includegraphics[
			page = 1,
			scale = 0.60,
			trim = 1.50cm 20.75cm 0cm 0cm, % left bottom right top
			clip
		]{.setup/latex/figures/pdf/mbr-page-1.pdf}
	\end{figure}
	\vspace{0em}
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{\textbf{Question:} How can we draw \textbf{population-level} conclusions from \textbf{person-specific dynamics} without averaging away the very individual differences we care about?}
			};
		\end{tikzpicture}
	\end{center}
	\note{
		\normalsize
		\begin{itemize}
			\item Study 3 asks how to preserve \textbf{person-specific dynamics} while still making valid \textbf{population-level} inferences.
			\item For me, this is not only a statistical problem.
			\item It is the problem behind many HDFS questions, because we often care about \textbf{dynamic parameters} that capture regulation, adaptation, spillover, and risk in ways that \textbf{differ meaningfully across people, dyads, and families}.
			\item So the question is how to synthesize those individual dynamic signatures without averaging away the heterogeneity that makes them substantively important.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{Dyadic phenotypes}
	\centering
	\includegraphics[scale = .5]{.setup/latex/figures/pdf/dyadic-phenotypes.pdf}
	\note{
		\normalsize
		\begin{itemize}
			\item Before I show the mechanics of MetaVAR, I want to show the kind of scientific target I care about.
			\item Imagine estimating a dynamic signature for each parent–child dyad: some dyads recover quickly after disturbance, some show stress contagion, some show buffering, and some show mutual amplification.
			\item Those are not just abstract parameters. They are candidate dynamic phenotypes of dyadic regulation and functioning.
			\item And once we can estimate those signatures well, the next question is \textbf{how to synthesize them without flattening the very heterogeneity that makes them interesting}.
			\item That is the problem MetaVAR is designed to solve.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{The trade-off MetaVAR is designed to solve}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/pdf/metavar-tradeoff-2.pdf}
	\note{
		\small
		\begin{itemize}
			\item There is a real trade-off here.
			\item One-step hierarchical models are attractive because they estimate population averages and individual differences together. But the cost is that person-specific dynamics can get pulled toward the population mean.
			\item At the other extreme, we can fit a separate model per person and summarize afterward. That preserves the idiographic fits and scales well, but it can treat all person-level estimates as if they were equally precise.
			\item MetaVAR is the middle ground: keep the person-specific models, but carry their uncertainty into the second stage.
			\item In HDFS terms, this matters whenever we care not only about the average person, dyad, or family, but also about how much meaningful variation there is around that average.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{How MetaVAR works}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/pdf/metavar-workflow.pdf}
	\begin{itemize}
		\tiny
		\item \url{https://CRAN.R-project.org/package=fitVARMxID}
		      \begin{itemize}
		      	\tiny
		      	\item \texttt{estimates <- FitVARMxID(data, observed = ("na", "pa"), id = "id", ncores = 32)}
		      \end{itemize}
		\item \url{https://CRAN.R-project.org/package=metaDyn}
		      \begin{itemize}
		      	\tiny
		      	\item \texttt{meta <- MetaVARMx(estimates)}
		      \end{itemize}
	\end{itemize}
	\note{
		\normalsize
		\begin{itemize}
			\item Stage 1 is person-specific estimation: each individual gets an idiographic model, which yields a dynamic signature and its sampling covariance matrix.
			\item Stage 2 is MetaVAR: instead of treating those person-specific estimates as error-free, the method synthesizes both the signatures and their uncertainty.
			\item That gives us valid population-level inference on average dynamics, between-person heterogeneity, and covariation among dynamic parameters.
		\end{itemize}		
	}
\end{frame}

\begin{frame}
	\frametitle{Simulation results: MetaVAR is strongest for heterogeneity}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/png/fig-vignettes-manuscript-figures-coverage-1.png}
	\note{
		\normalsize
		\begin{itemize}
			\item The simulation clarifies where MetaVAR is especially useful.
			\item Its clearest advantage is when the scientific target is \textbf{heterogeneity}: how much people differ, and how well we calibrate uncertainty about those differences.
			\item For population averages, the Bayesian multilevel comparator remained competitive.
			\item So I see MetaVAR not as a universal replacement, but as a strong option when we want to preserve idiographic estimation while still drawing valid population-level inferences about heterogeneity.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{Empirical illustration: Average affect dynamics}
	\begin{minipage}[c]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/empirical-inertia.pdf}
	\end{minipage}\hfill
	\begin{minipage}[c]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/empirical-na-to-pa.pdf}
	\end{minipage}
	\note{
		\small
		\begin{itemize}
			\item So let me now show what that looks like in real data.
			\item I will start with the population-average affect system, not because the mean is the whole story, but because it gives us an interpretable baseline.
			\item On average, people show higher positive affect than negative affect, and both processes show positive inertia.
			\item I am also showing one representative cross-lagged result here: higher negative affect predicts lower later positive affect.
			\item The companion result goes in the same direction for positive affect predicting lower later negative affect, so the average system reflects \textbf{reciprocal inhibitory coupling}.
			\item Then, in the next slide, I will show the part MetaVAR is especially good at: how much people differ around that average.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{Empirical illustration: Heterogeneity in affect dynamics}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/pdf/empirical-heterogeneity.pdf}
	\note{
		\footnotesize
		\begin{itemize}
			\item The more important result is not only where the average lies, but how much people differ around it.
			\item The dot is the population average, the thin interval is the 95\% confidence interval for that average, and the wider band shows approximate between-person heterogeneity around it.
			\item That wider band comes from the random-effects variance for each parameter, so it reflects population spread rather than uncertainty about the mean.
			\item So people differ meaningfully in their set points, in how persistent affect is, and in how strongly negative and positive affect influence one another over time.
			\item The payoff is that heterogeneity stops being a nuisance term and becomes a substantive result: people differ in their set points, persistence, coupling, and co-fluctuation, and those differences are exactly what we often care about in HDFS.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\vspace*{0.3em}
	{\large\color{blue!70!black}Examining heterogeneity and downstream effects\par}
	\vspace{0.4em}
	\centering
	\includegraphics[
		width=.85\paperwidth,
		height=.85\paperheight,
		keepaspectratio,
		trim=0.3cm 0cm 0.3cm 0cm, % left bottom right top
		clip
	]{.setup/latex/figures/pdf/covariate-outcome.pdf}
	\begin{itemize}
		\tiny
		\item \url{https://CRAN.R-project.org/package=metaDyn}
		      \begin{itemize}
		      	\tiny
		      	\item \texttt{meta <- MetaVARMx(estimates, x = contextual, z = downstream)}
		      \end{itemize}
	\end{itemize}
	\note{
		\normalsize
		\begin{itemize}
			\item This slide shows why MetaVAR matters beyond a single methods paper.
			\item In a broader SEM framework, person-specific dynamic signatures can be modeled as outcomes of contextual factors and as predictors of later outcomes.
			\item So instead of stopping at ``people differ,'' we can ask what predicts those differences and why they matter downstream.
			\item That is the bridge to the next slide: toward dynamic phenotypes in HDFS.
		\end{itemize}
	}
\end{frame}

%-------------------------------------------------------------------------------
\section{Future directions}
%-------------------------------------------------------------------------------

\begin{frame}
	\vspace*{0.3em}
	{\large\color{blue!70!black}Future directions: Toward scalable dynamic phenotypes in HDFS\par}
	\vspace{0.4em}
	\centering
	\includegraphics[
		width=.8\paperwidth,
		height=.8\paperheight,
		keepaspectratio,
		trim=.22cm 1.1cm .22cm .8cm, % left bottom right top
		clip
	]{.setup/latex/figures/pdf/dynamic-synthesis-platform.pdf}
	% \includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/cattells-box.pdf}
	% \raggedright
	% {\tiny Related ongoing work: invited full-manuscript submission to a \textit{Psychometrika} special issue on ``Data Intensive Methods in Psychometrics.''}
	\note{
		\normalsize
		\begin{itemize}
			\item This slide is about the 5- to 10-year arc of my research program.
			\item A central challenge is scale: many existing dynamic methods become harder to use as we add more variables, more levels, and richer data sources.
			\item My goal is to build a scalable synthesis framework for dynamic phenotypes: estimate them locally, carry uncertainty forward, and combine them rigorously.
			\item The long-term aim is methods that scale with HDFS science without losing rigor, interpretability, or usability.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\vspace*{0.3em}
	{\large\color{blue!70!black}Future directions: Making dynamic synthesis usable\par}
	\vspace{0.4em}
	\centering
	\includegraphics[
		width=.9\paperwidth,
		height=.9\paperheight,
		keepaspectratio,
		trim=1.3cm 0.25cm 0cm 1cm, % left bottom right top
		clip
	]{.setup/latex/figures/pdf/infrastructure.pdf}
	\note{
		\footnotesize
		\begin{itemize}
			\item This slide is about infrastructure, in three senses.
			\item First, the hardware backend: CPUs, GPUs, and HPC nodes that let us estimate many local dynamic models in parallel.
			\item Second, careful synthesis: translating statistical ideas into algorithms that combine those local models rigorously while preserving uncertainty and heterogeneity.
			\item Third, usable tools: packages, containers, and workflows that put those methods into forms collaborators and students can actually use.
			\item That is the kind of infrastructure I would want to bring to the department---infrastructure that supports collaboration, training, and reproducible quantitative work.
			\item And ultimately, it is all in service of the same goal: studying dynamic processes in development, family life, and health in ways that are substantively meaningful and methodologically usable.
		\end{itemize}
	}
\end{frame}

