\setbeamertemplate{navigation symbols}{}

\begin{frame}[plain]
	\titlepage
	\note{
		\scriptsize
		\begin{itemize}
			\item Good morning, and thank you for the opportunity to be here. I am Ivan Jacob Agaloos Pesiga, Jek for short.
			\item At the center of my research program is a simple goal: to understand \textbf{dynamic processes} in \textit{development}, \textit{family life}, and \textit{health} in ways that are \textbf{substantively meaningful} and \textbf{methodologically usable}.
			\item In particular, I study \textit{how change unfolds over time}, \textit{how people differ in those processes}, and \textit{how we can build tools that help researchers study those questions well}.
			\item What draws me to HDFS is that these questions are inherently \textbf{contextual} and \textbf{multilevel}, showing up in \textit{individuals}, \textit{relationships}, \textit{families}, and \textit{everyday} settings.
			\item Today, I will walk through three recent studies that reflect that agenda.
			\item Across them, the common thread is \textbf{methodology in service of substantive questions}.
			\item I will end with a few future directions I would be especially excited to pursue at Penn State HDFS.
		\end{itemize}
	}
\end{frame}

