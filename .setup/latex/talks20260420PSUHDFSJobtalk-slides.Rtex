\section{Study 2}
%-------------------------------------------------------------------------------

\begin{frame}
	\frametitle{Study 2}
	\begin{figure}[ht]
		\centering
		% Main figure
		\includegraphics[
			page = 1,
			scale = 0.60,
			trim = 1.50cm 20.75cm 0cm 0cm, % left bottom right top
			clip
		]{.setup/latex/figures/pdf/adb-page-1.pdf}
	\end{figure}
	\vspace{0em}
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{\textbf{Question:} Can inertia help distinguish qualitatively different drinking patterns, beyond differences in average intoxication level?}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

\begin{frame}
	\frametitle{Why this substantive problem demanded a new model}
	% \scriptsize
	% \begin{minipage}[t]{0.48\textwidth}
	% \textbf{Substantive grounding}
	% \begin{itemize}
	% 	\item Addiction and alcohol have been a consistent substantive thread in my work.
	% \end{itemize}
								
	% \textbf{Why this matters}
	% \begin{itemize}
	% 	\item Young adulthood is a high-risk period for heavy episodic drinking.
	% 	\item Risk is not only about \textbf{how much} people drink, but also about \textbf{how intoxication carries over} across days.
	% \end{itemize}
	% \end{minipage}\hfill
	% \begin{minipage}[t]{0.48\textwidth}
	\textbf{Why Study 2 is exciting}
	% Herring-Zamboanga-Olthuis-etal-2016
	% Russell-Richards-Turrisi-etal-2025
	\begin{itemize}
		\item \textbf{Substantive grounding:} Alcohol and addiction have been a consistent part of my applied work {\tiny \parencite[e.g.][]{Zhang-Ku-Wu-et-al-2020, Zhang-Pesigan-Kahler-etal-2019, Zamboanga-Iwamoto-Pesigan-etal-2015, Zamboanga-Pesigan-Tomaso-etal-2015, Yu-Pesigan-Zhang-etal-2019, Yu-Wu-Pesigan-2015}}.
		\item \textbf{Substantive question:} How do risky drinking patterns persist or change across days?
		\item \textbf{Methodological challenge:} Transdermal alcohol concentration (TAC) features are multidimensional, partly shared, partly feature-specific, and dynamic over time.
	\end{itemize}
	% \vspace{0em}
	% \textbf{Data}
	% \begin{itemize}
	% 	\item 222 young adults engaged in weekly HED
	% 	\item 6-day sensor-based monitoring
	% 	\item Baseline alcohol use disorder risk measured using \texttt{AUDIT}
	% \end{itemize}
	% \end{minipage}
	\vspace{0em}
	\normalsize
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{\textbf{Substantive grounding} in addiction research, together with the quantitative expertise to build \textbf{new models} when the science demands them.}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

\begin{frame}
	\frametitle{From TAC curves to dynamic questions}
	\begin{minipage}[t]{0.54\textwidth}
		\vspace{0pt}
		\centering
		\includegraphics[width=\linewidth]{.setup/latex/figures/pdf/tac.pdf}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.42\textwidth}
		\vspace{0pt}
		\small
		Simple summaries of the TAC features miss three things:
		\begin{itemize}
			\item what is \textbf{shared} across features,
			\item what is \textbf{feature-specific},
			\item and whether intoxication shows \textbf{inertia} across days.
		\end{itemize}
	\end{minipage}
	\vspace{0em}
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{The question is not just \textbf{how intoxicated was this day?} but also \textbf{what kind of drinking pattern does it reflect, and how stable is that pattern over time?}}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

\begin{frame}
	\frametitle{Profiles differed in mean intoxication and inertia}
	\begin{minipage}[t]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/profiles-2.pdf}
		\vspace{0.3em}
		{\scriptsize \textbf{Difference in mean levels}}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.5\textwidth}
		\centering
		\includegraphics[width=\linewidth,height=0.42\textheight,keepaspectratio]{.setup/latex/figures/pdf/rs-high-low.pdf}
		\vspace{0.3em}
		{\scriptsize \textbf{Difference in temporal persistence}}
	\end{minipage}\hfill
	\footnotesize
	\begin{itemize}
		\item Chronic HED: \textcolor{myviolet}{Higher intoxication mean} and \textcolor{myblue}{Lower inertia}
		\item Inertia-driven drinking: \textcolor{myteal}{Lower intoxication mean} and \textcolor{myred}{Higher inertia}
	\end{itemize}
	\vspace{0em}
	\normalsize
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=\linewidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{The key point is that these profiles are \textbf{not defined by means alone}. They also differ in \textbf{how strongly intoxication carries forward} across days.}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

\begin{frame}{AUD risk predicts getting stuck in chronic HED}
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Start in chronic HED}
				
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.03 $\rightarrow$ 0.07 $\rightarrow$ 0.15}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Stay in chronic HED}
				
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.21 $\rightarrow$ 0.30 $\rightarrow$ 0.40}
	\end{minipage}\hfill
	\begin{minipage}[t]{0.31\textwidth}
		\vspace{0pt}
		\centering
		\textbf{Shift into chronic HED}
				
		\vspace{0.6em}
		{\scriptsize
			No risk $\rightarrow$ Risk $\rightarrow$ Likely AUD\\[0.2em]
			0.03 $\rightarrow$ 0.06 $\rightarrow$ 0.10}
	\end{minipage}
		
	\vspace{0.8em}
		
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=0.96\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{CULTA does not just classify drinking days; it helps identify \textbf{who is likely to get stuck in riskier dynamic patterns}.}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

%-------------------------------------------------------------------------------
\section{Study 3}
%-------------------------------------------------------------------------------

\begin{frame}
	\frametitle{Study 3}
	\begin{figure}[ht]
		\centering
		% Main figure
		\includegraphics[
			page = 1,
			scale = 0.60,
			trim = 1.50cm 20.75cm 0cm 0cm, % left bottom right top
			clip
		]{.setup/latex/figures/pdf/mbr-page-1.pdf}
	\end{figure}
	\vspace{0em}
	\begin{center}
		\begin{tikzpicture}
			\node[
				draw=indirect,
				rounded corners=4pt,
				line width=0.8pt,
				fill=white,
				inner xsep=8pt,
				inner ysep=6pt,
				text width=\textwidth,
				align=center
			] {%
				\small
				\textcolor{indirect}{\textbf{Question:} How can we draw \textbf{population-level} conclusions from \textbf{person-specific dynamics} without averaging away the very individual differences we care about?}
			};
		\end{tikzpicture}
	\end{center}
\end{frame}

\begin{frame}
	\frametitle{Dyadic phenotypes}
	\centering
	\includegraphics[scale = .5]{.setup/latex/figures/pdf/dyadic-phenotypes.pdf}
\end{frame}

\begin{frame}
	\frametitle{The trade-off MetaVAR is designed to solve}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/pdf/metavar-tradeoff-2.pdf}
	\note{
		\small
		\begin{itemize}
			\item There is a real trade-off here.
			\item One-step hierarchical models are attractive because they estimate population averages and individual differences together. But the cost is that person-specific dynamics can get pulled toward the population mean.
			\item At the other extreme, we can fit a separate model per person and summarize afterward. That preserves the idiographic fits and scales well, but it can treat all person-level estimates as if they were equally precise.
			\item MetaVAR is the middle ground: keep the person-specific models, but carry their uncertainty into the second stage.
			\item In HDFS terms, this matters whenever we care not only about the average person, dyad, or family, but also about how much meaningful variation there is around that average.
		\end{itemize}
	}
\end{frame}

\begin{frame}
	\frametitle{How MetaVAR works}
	\centering
	\includegraphics[width=\linewidth,height=\textheight,keepaspectratio]{.setup/latex/figures/pdf/metavar-workflow.pdf}
	\begin{itemize}
		\tiny
		\item \url{https://CRAN.R-project.org/package=fitVARMxID}
		      \begin{itemize}
		      	\tiny
		      	\item \texttt{estimates <- FitVARMxID(data, observed = ("na", "pa"), id = "id", ncores = 32)}
		      \end{itemize}
		\item \url{https://CRAN.R-project.org/package=metaDyn}
		      \begin{itemize}
		      	\tiny
		      	\item \texttt{meta <- MetaVARMx(estimates)}
		      \end{itemize}
	\end{itemize}
\end{frame}

